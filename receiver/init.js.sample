// Receiver plugins initialization for OpenWebRX+.
// Copy this file to /path/to/htdocs/plugins/receiver/init.js to use it.
// Everything starting with '//' is a comment.

// uncomment to enable plugin debugging.
// Plugins._enable_debug = true;

// Optional per-plugin settings before load
// Plugins.tune_precise_steps = [12500, 5000, 10];

// List the plugins you want to load (folder names). Order matters if plugins depend on each other.
const PluginsToLoad = [
	'colorful_spectrum',
	'connect_notify',
	'frequency_far_jump',
	'screen_reader',
	'screenshot',
	'doppler',
	'tune_precise',
	'toggle_scannable',
];

// Load dependencies first, then plugins (await enforces order).
// Change the base URL if you mirror these plugins elsewhere.
(async () => {
	await Plugins.load('https://0xaf.github.io/openwebrxplus-plugins/receiver/utils/utils.js');
	// Plugins.utils._DEBUG_ALL_EVENTS = true;

	// Wait until the receiver page is fully initialized before loading the rest.
	// Built-in plugins (e.g. KeyPlugin) need the receiver panel to exist.
	await new Promise(resolve => Plugins.utils.on_ready(resolve));

	// Built-in (native) OpenWebRX+ plugins. Uncomment to enable.
	// These are part of OpenWebRX+ itself and must not be loaded with Plugins.load().
	// Start them before other plugins: deprecated plugins like minimap reuse them
	// instead of starting them a second time.
	// MapPlugin.init(); // native map in a floating window (OpenWebRX+ 1.2.124+)
	// SunPlugin.init(); // Solar Weather from HamQSL (OpenWebRX+ 1.2.125+)
	// KeyPlugin.init(); // Magic Key input in the Settings section (OpenWebRX+ 1.2.125+)
	// RigPlugin.init(); // RigControl PTT button, hold Backspace to transmit (OpenWebRX+ 1.2.125+)

	await Plugins.load('https://0xaf.github.io/openwebrxplus-plugins/receiver/notify/notify.js');

	// Load a local plugin if you have one
	// await Plugins.load('example');

	// Load the plugins listed above from remote URL
	for (const pluginName of PluginsToLoad) {
		await Plugins.load(`https://0xaf.github.io/openwebrxplus-plugins/receiver/${pluginName}/${pluginName}.js`);
	}

	// Let users enable plugins themselves from a Plugins window (puzzle button, OpenWebRX+ 1.2.124+).
	// Keep it last: everything loaded before setup() is shown as "loaded by admin".
	// await Plugins.load('https://0xaf.github.io/openwebrxplus-plugins/receiver/plugin_loader/plugin_loader.js');
	// Plugins.plugin_loader.setup({
	// 	allowed: ['doppler', 'screenshot', 'tune_precise', 'MapPlugin', 'SunPlugin'],
	// 	allow_all: false,          // true = users may enable any repository or built-in plugin
	// 	allow_experimental: false, // true = users may enable experimental plugins
	// 	allow_thirdparty: false,   // true = users may enable third-party plugins
	// });
})();

// vim: ft=javascript
